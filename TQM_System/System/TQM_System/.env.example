# ============================================================
# ไฟล์ตัวอย่างค่าตั้งค่า — ไฟล์นี้ขึ้น git ได้ (ไม่มีความลับ)
# ------------------------------------------------------------
# วิธีใช้: ก๊อปไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องนั้น
#   Windows :  Copy-Item .env.example .env
#   Linux   :  cp .env.example .env
#
# ⚠ ไฟล์ .env ตัวจริงห้ามขึ้น git เด็ดขาด (อยู่ใน .gitignore แล้ว)
# ============================================================


# ── กุญแจลับของ Django ─────────────────────────
# เซิร์ฟจริงต้องสร้างใหม่ ห้ามใช้ตัวเดียวกับเครื่องพัฒนา
# สร้างด้วย:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=เปลี่ยนค่านี้


# ── โหมดการทำงาน ───────────────────────────────
# True  = เครื่องพัฒนา (แสดงรายละเอียด error)
# False = เซิร์ฟจริง   (ห้ามเป็น True เด็ดขาด)
DEBUG=False


# ── โดเมนที่อนุญาต (คั่นด้วยจุลภาค) ──────────────
# เครื่องพัฒนา : 127.0.0.1,localhost
# เซิร์ฟจริง   : tqm.eaksaha.co.th,www.tqm.eaksaha.co.th
ALLOWED_HOSTS=127.0.0.1,localhost

# ต้องใส่ https:// นำหน้าเสมอ (ใช้ตอนส่งฟอร์ม)
# เซิร์ฟจริง : https://tqm.eaksaha.co.th
CSRF_TRUSTED_ORIGINS=


# ── ฐานข้อมูล ──────────────────────────────────
# เครื่องพัฒนา : sqlite:///db.sqlite3
# เซิร์ฟจริง   : postgres://ชื่อผู้ใช้:รหัสผ่าน@localhost:5432/tqm
DATABASE_URL=sqlite:///db.sqlite3


# ── ที่เก็บไฟล์อัปโหลด (รูปก่อน/หลังขึ้นรถสไลด์) ──
# เซิร์ฟจริงควรชี้ออกนอกโฟลเดอร์โค้ด เช่น /var/www/tqm/media
# MEDIA_ROOT=/var/www/tqm/media


# ── ไฟล์ log (ใช้เฉพาะตอน DEBUG=False) ──────────
# LOG_FILE=/var/log/tqm/django.log
